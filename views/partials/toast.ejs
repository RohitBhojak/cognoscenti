<div id="toast-container" className="fixed top-5 right-5 z-50"></div>

<script>
  const typeColorMap = {
    success: "bg-green-600",
    error: "bg-red-600",
    warning: "bg-yellow-500",
    default: "bg-gray-500"
  };

  document.body.addEventListener("showToast", (e) => {
    const {
      message,
      type
    } = e.detail;

    const toast = document.createElement("div");
    const bgColor = typeColorMap[type] || typeColorMap.default;

    toast.className = `px-4 py-3 rounded text-white shadow-lg transition-opacity duration-300 opacity-100 ${bgColor}`;
    toast.innerText = message;

    document.querySelector("#toast-container").appendChild(toast);

    setTimeout(() => {
      toast.className = 'opacity-0';
      setTimeout(() => {
        toast.remove();
      }, 300)
    }, 3000)
  })
</script>