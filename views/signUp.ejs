<%- include("partials/header") %>

<form action="/sign-up" method="post" class="flex flex-col gap-8 max-w-xl bg-neutral mt-40 mx-auto p-10 rounded-lg">

  <%- include("partials/inputText", {id: "username", label: "username", required: true}) %>
  <%- include("partials/inputText", {id: "password", label: "password", required: true, type: "password"}) %>
  <%- include("partials/inputText", {id: "adminSecretKey", label: "admin secret key", type: "password"}) %>
  <%- include("partials/buttonPrimary", {label: "Sign Up"})%>
  <hr class="text-secondary" />
  <p class="text-tertiary-light mx-auto">Already have an account? <a href="#" class="text-primary hover:text-primary-light">Login</a></p>
</form>

<%- include("partials/footer") %>