<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= locals.title || "Cognoscenti" %></title>
  <link rel="stylesheet" href="/css/output.css">
  <link rel="icon" type="image/x-icon" href="/assets/favicon.ico" sizes="any">
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.10/dist/htmx.min.js" integrity="sha384-H5SrcfygHmAuTDZphMHqBJLc3FhssKjG7w/CeCpFReSfwBWDTKpkzPP8c+cLsK+V" crossorigin="anonymous"></script>
  <script src="/scripts/app.min.js" defer></script>
</head>

<body class="bg-neutral-dark antialiased m-5" hx-indicator="#app-spinner">
  <header>
    <nav class="flex justify-between items-center relative">
      <% 
      const navLinks = [
        { name: "Archive", path: "/" },
        { name: "Genres", path: "/genres" },
        { name: "Submit", path: "/submit" }
      ];

      const profileLinks = [
        {name: "My Archive", path: "/my-archive", icon: icons.Bookmark},
        {name: "Logout", path: "/auth/logout", method: "post", icon: icons.LogOut}
      ]

      const guestLinks = [
        {name: "Login", path: "/auth/login", icon: icons.LogIn},
        {name: "Create Account", path: "/auth/sign-up", icon: icons.UserPlus}
      ]
    %>
      <div class="flex items-center gap-3">
        <%- include("../components/hamburgerMenu", {icon: icons.Menu, iconColor: "text-primary", heading:"Navigation", position: "left", links: navLinks, hide: "md:hidden"}) %>

        <a href="/" hx-get="/" hx-target="#app" hx-swap="innerHTML" class="text-primary font-serif font-bold text-lg uppercase">
          Cognoscenti
        </a>
      </div>

      <!-- Desktop Nav Links -->
      <ul id="nav-list" class="hidden md:flex text-tertiary-light gap-4">
        <% for (const link of navLinks) { %>
        <li>
          <a href="<%= link.path %>" hx-get="<%= link.path %>" hx-target="#app" hx-swap="innerHTML" hx-push-url="true" class="hover:text-primary transition-all capitalize font-serif py-1">
            <%= link.name %>
          </a>
        </li>
        <% } %>
      </ul>

      <!-- Account Menus -->
      <% if (locals.currentUser) { %>
      <span class="w-2 h-2 rounded-full bg-emerald-500 absolute right-8"></span>
      <%- include("../components/hamburgerMenu", {icon: icons.CircleUserRound, iconColor: "text-primary", heading:currentUser.username, position: "right", links: profileLinks, hide: ""}) %>
      <% } else { %>
      <%- include("../components/hamburgerMenu", {icon: icons.CircleUserRound, iconColor: "text-tertiary-light", heading:"Guest", position: "right", links: guestLinks, hide: ""}) %>
      <% } %>
    </nav>
  </header>
  <div id="app-spinner" class="htmx-indicator fixed inset-x-0 bottom-0 top-13 bg-neutral-dark/60 backdrop-blur-[1px] flex flex-col items-center justify-center z-40 transition-opacity">
    <div class="animate-spin h-10 w-10 border-4 border-primary border-t-transparent rounded-full shadow-lg"></div>
    <span class="mt-3 text-xs font-semibold uppercase tracking-wider text-tertiary-light">Loading...</span>
  </div>
  <main id="app">
    <%- body %>
  </main>

</body>

</html>