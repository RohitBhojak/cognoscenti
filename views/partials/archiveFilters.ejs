<form id="search" hx-get="/archive" hx-target="#archive-list" hx-swap="innerHTML" class="grid grid-cols-[repeat(auto-fill,minmax(240px,1fr))] gap-x-8 gap-y-2 items-end mt-10 mx-auto text-sm">
  <%- include("../components/inputText", {id: "title", label: "Title"}) %>
  <%- include("../components/inputText", {id: "genre", label: "Genre", datalistUrl: "/options/genres"}) %>
  <%- include("../components/inputText", {id: "director", label: "Director", datalistUrl: "/options/directors"}) %>
  <%- include("../components/inputText", {id: "year", label: "Year Of Release", type: "number"}) %>
  <%- include("../components/buttonPrimary", {id: "search-btn", type: "submit", label:"Apply Filters", spinner: "true"}) %>
</form>