<%# hide, heading, icon, iconColor, position, links: {path, method, icon, name} %>
<div class="relative group <%= hide %>">
  <button type="button" aria-label="Toggle <%= heading %>" class="<%= iconColor %> hover:text-primary-light flex items-center focus:outline-none cursor-pointer [&>svg]:w-7 [&>svg]:h-7">
    <%- icon %>
  </button>

  <div class="absolute <%= position %>-0 top-full hidden group-hover:block group-focus-within:block w-48 border border-neutral-700 rounded-md shadow-lg py-1 z-50 bg-neutral text-tertiary-light">
    <div class="px-4 py-2 mb-1 text-xs font-semibold uppercase tracking-wider text-tertiary-light/80 border-b border-neutral-800">
      <%= heading %>
    </div>

    <% for (const link of links) { %>
    <a href="<%= link.path %>" <%= link.method === 'post' ? 'hx-post=' + link.path : 'hx-get=' + link.path %> hx-target="#app" hx-swap="innerHTML" hx-push-url="true" class="flex items-center gap-2 px-4 py-2 text-sm hover:text-primary hover:bg-neutral-800 transition-colors capitalize font-medium">
      <span class="flex items-center gap-1 [&>svg]:w-4 [&>svg]:h-4"><%- link.icon %><%= link.name %></span>
    </a>
    <% } %>
  </div>
</div>