<div class="flex flex-col gap-1">
  <label for="<%= id %>" class="uppercase text-primary tracking-widest"><%= label %> <%= locals.required ? '*' : '' %></label>
  <div class="input-container relative flex items-center">
    <input name="<%= id %>" id="<%= id %>" placeholder="Enter <%= label %>" type="<%= locals.type || "text"%>" value="<%= locals.values?.[id]%>" <% if (locals.required) { %> required <% } %> class="w-full text-tertiary-light font-serif py-2 border-b focus:outline-none border-b-tertiary focus:border-b-primary transition-colors duration-300" <% if(locals.validateUrl) {%> hx-post="<%- validateUrl %>" hx-trigger="keyup changed delay:400, blur" hx-target="#<%= id %>-error" hx-swap="innerHTML" hx-params="<%= id %>" <% } %> />
    <% if (locals.type === "password") { %>
    <button type="button" aria-label="Toggle password visibility" data-toggle-password class="absolute cursor-pointer right-0 text-tertiary hover:text-primary transition-colors">
      <span class="icon-eye"><%- icons.Eye %></span>
      <span class="icon-eye-off hidden"><%- icons.EyeOff %></span>
    </button>
    <% } %>
  </div>
  <div id="<%= id %>-error" data-error><%- include("./formError", {error: locals.errors?.[id]?.msg}) %></div>
</div>