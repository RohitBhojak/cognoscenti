<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= locals.title || "Cognoscenti" %></title>
  <!-- Compiled Tailwind CSS -->
  <link rel="stylesheet" href="/css/output.css">
  <!-- HTMX -->
  <script src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.10/dist/htmx.min.js" integrity="sha384-H5SrcfygHmAuTDZphMHqBJLc3FhssKjG7w/CeCpFReSfwBWDTKpkzPP8c+cLsK+V" crossorigin="anonymous"></script>
  <!-- Fallback for older browsers -->
  <link rel="icon" type="image/x-icon" href="/assets/favicon.ico" sizes="any">
  <!-- Modern SVG icon for current browsers -->
  <link rel="icon" type="image/svg+xml" href="/assets/favicon.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200..800&family=Newsreader:ital,opsz,wght@0,6..72,200..800;1,6..72,200..800&display=swap" rel="stylesheet">
</head>

<body class="bg-neutral-dark antialiased m-5">

  <header>
    <nav class="flex justify-between">
      <div class="text-primary"><%- icons.Clapperboard %></div>
      <ul class="flex text-tertiary-light gap-4">
        <% 
        const links = [
          { name: "archive", path: "/" },
          { name: "genres", path: "/genres" },
          { name: "submit", path: "/submit" }
        ];
        const active = locals.activePage || '';
      %>
        <% for (const link of links) { %>
        <% const isActive = active === link.name; %>
        <li>
          <a href="<%= link.path %>" class="hover:text-primary transition-all capitalize font-serif py-1 <%= isActive ? 'text-primary border-b-2 border-primary' : '' %>">
            <%= link.name %>
          </a>
        </li>
        <% } %>
      </ul>
      <div class="text-primary"><%- icons.CircleUserRound %></div>
    </nav>
  </header>

  <main id="app">
    <%- body %>
  </main>

  <script>
    document.body.addEventListener('htmx:beforeSwap', function(e) {
      if (e.detail.xhr.status >= 400 && e.detail.xhr.status < 500) {
        e.detail.shouldSwap = true;
        e.detail.isError = false;
      }
    });
  </script>

</body>

</html>