{
  "name": "cognoscenti",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev:css": "npx @tailwindcss/cli -i ./src/styles/input.css -o ./public/output.css --watch",
    "dev:node": "tsx watch src/index.ts",
    "dev": "concurrently -k \"npm run dev:css\" \"npm run dev:node\"",
    "build:css": "npx @tailwindcss/cli -i ./src/styles/input.css -o ./public/output.css --minify",
    "build:node": "tsc",
    "build": "npm run build:css && npm run build:node",
    "start": "node --env-file=.env dist/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "db:setup": "tsx --env-file=.env src/models/populateDB.ts --schema=src/models/schema.sql --seed=src/models/seed.sql",
    "db:schema": "tsx --env-file=.env src/models/populateDB.ts --schema=src/models/schema.sql",
    "db:seed": "tsx --env-file=.env src/models/populateDB.ts --seed=src/models/seed.sql",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RohitBhojak/cognoscenti.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/RohitBhojak/cognoscenti/issues"
  },
  "homepage": "https://github.com/RohitBhojak/cognoscenti#readme",
  "dependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "bcrypt": "^6.0.0",
    "concurrently": "^10.0.4",
    "ejs": "^5.0.2",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "pg": "^8.22.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  }
}
