<div class="flex flex-col">
  <label for="<%= id %>" class="uppercase text-primary tracking-widest"><%= label %> <%= locals.required ? '*' : '' %></label>
  <input name="<%= id %>" id="<%= id %>" placeholder="Enter <%= label %>" type="<%= locals.type || "text"%>" class="text-tertiary-light font-serif py-2 border-b focus:outline-none border-b-tertiary focus:border-b-primary transition-colors duration-300" />
</div>