<%# id, label, required, multiple, name, options, validateUrl, values: {id}, errors: {id: {msg}} %>
<% 
  const hasValidation = Boolean(locals.validateUrl);
  const fieldName = locals.name || id;
  const rawValue = locals.values?.[id];
  const selectedValues = rawValue === undefined || rawValue === null
    ? []
    : (Array.isArray(rawValue) ? rawValue : [rawValue]).map(String);
%>

<div class="flex flex-col gap-1" hx-disinherit="hx-indicator">
  <div class="relative flex items-center">
    <span id="<%= id %>-label" class="uppercase text-primary tracking-widest">
      <%= label %> <%= locals.required ? '*' : '' %>
    </span>

    <% if (hasValidation) { %>
    <%- include("./spinner", {color: "border-primary", position: "absolute right-0"}) %>
    <% } %>
  </div>

  <div id="<%= id %>" role="group" aria-labelledby="<%= id %>-label" class="flex flex-wrap gap-3 pt-1" <%# HTMX Inline Field Validation %> <% if (hasValidation) { %> hx-post="<%- validateUrl %>" hx-trigger="change" hx-target="#<%= id %>-error" hx-swap="innerHTML" hx-include="[name='<%= fieldName %>']" hx-indicator="#<%= id %>-spinner" <% } %>>
    <% (locals.options || []).forEach((option, index) => {
      const value = String(option.id);
      const isChecked = selectedValues.includes(value);
    %>
    <label class="cursor-pointer select-none rounded-full">
      <input type="<%= locals.multiple === false ? 'radio' : 'checkbox' %>" name="<%= fieldName %>" value="<%= value %>" <% if (locals.required && index === 0) { %> required <% } %> <% if (isChecked) { %> checked <% } %> class="peer sr-only">
      <span class="inline-block px-5 py-2 rounded-full border border-tertiary text-sm font-sans text-tertiary-light transition-all duration-300
             hover:border-primary hover:text-primary
             peer-checked:bg-primary peer-checked:border-primary peer-checked:text-neutral-dark peer-checked:font-bold
             peer-checked:hover:bg-primary-light peer-checked:hover:border-primary-light peer-checked:hover:text-neutral-dark
             peer-focus-visible:ring-2 peer-focus-visible:ring-primary/50"> <%= option.name %>
      </span>
    </label>
    <% }) %>
  </div>

  <div id="<%= id %>-error" data-error>
    <%- include("./formError", {error: locals.errors?.[id]?.msg}) %>
  </div>
</div>