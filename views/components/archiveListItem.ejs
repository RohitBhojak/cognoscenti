<%# item {title, poster_url, release_year, director} %>
<div class="group block cursor-pointer [content-visibility:auto] [contain-intrinsic-size:auto_28rem]" data-center-focus>
  <div class="overflow-hidden rounded-md shadow-xl shadow-neutral-light">
    <img src="<%= item.poster_url || '/assets/cinema.webp'%>" loading="lazy" decoding="async" class="aspect-2/3 object-cover w-full grayscale transition-all duration-500 ease-in-out
             group-[.is-active]:grayscale-0 group-[.is-active]:scale-110
             [@media(hover:hover)]:group-hover:grayscale-0 [@media(hover:hover)]:group-hover:scale-110" />
  </div>

  <div class="mt-2">
    <span class="font-serif text-xl text-tertiary-light"><%= item.title %></span>
    <div class="flex items-center gap-2">
      <span class="font-sans text-primary-light"><%= item.release_year %></span>
      <span class="w-1.5 h-1.5 rounded-full bg-tertiary inline-block"></span>
      <span class="font-sans italic capitalize text-primary"><%= item.director %></span>
    </div>
  </div>
</div>